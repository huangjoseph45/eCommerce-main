# Backend env. Copy to .env (never commit .env).
# MongoDB connection string (Atlas or local mongod).
MONGO_URI=mongodb://localhost:27017/imagine-collective
# Secret for express-session cookies. Generate a long random value.
SESSION_SALT_SECRET=change-me-to-a-long-random-string
# Port the API listens on.
PORT=2000
# "true" on the deployed backend: enables secure cross-site session cookies
# for the imagine-collective.tech domain. Leave unset/false locally.
PROD=false
# Origin of the storefront, for CORS (the deployed frontend URL in prod).
VITE_CLIENT_PATH=http://localhost:5173
# Stripe secret key (sk_test_... locally, sk_live_... in prod).
STRIPE_SECRET=
# AWS region and S3 bucket for product images.
REGION=us-east-2
S3_BUCKET_NAME=
# AWS credentials come from the environment (IAM role / AWS CLI profile),
# not from this file.
